#!/usr/bin/env bash

set -uo pipefail

repository_root=$(git rev-parse --show-toplevel)
cd "$repository_root" || exit 1

failures=0
control_path="tests/fixtures/lab02-unsafe-control.txt"
temporary_directory=$(mktemp -d)

cleanup() {
  rm -f -- "$control_path"
}

cleanup_all() {
  cleanup
  rm -rf -- "$temporary_directory"
}
trap cleanup_all EXIT

record_failure() {
  printf 'FAIL: %s\n' "$1" >&2
  failures=$((failures + 1))
}

if ! command -v gitleaks >/dev/null 2>&1; then
  printf 'FAIL: gitleaks is not available; reopen this repository in its devcontainer.\n' >&2
  exit 1
fi

if ! npm test; then
  record_failure "npm test did not pass"
fi

if ! grep -Eq '^[[:space:]]*useDefault[[:space:]]*=[[:space:]]*true([[:space:]]*#.*)?$' .gitleaks.toml; then
  record_failure ".gitleaks.toml does not extend the default Gitleaks rules"
fi

if [[ -e .gitleaksignore ]]; then
  record_failure ".gitleaksignore bypasses the policy exercised in this lab"
fi

if ! gitleaks dir --config .gitleaks.toml --no-banner .; then
  record_failure "the configured tree scan reports a finding in the submitted tree"
fi

control_part_a="a84f0c27e9b631d2"
control_part_b="f5804ac713de9b26"
printf 'service_token = "svc_live_%s%s"\n' "$control_part_a" "$control_part_b" > "$control_path"
control_report="$temporary_directory/control-report.json"
if gitleaks dir --config .gitleaks.toml --no-banner --report-format json --report-path "$control_report" .; then
  record_failure "the configured tree scan accepted the unsafe control"
elif ! grep -q 'tests/fixtures/lab02-unsafe-control.txt' "$control_report"; then
  record_failure "the unsafe control failed the scan for an unexpected reason"
fi
cleanup

history_report="$temporary_directory/history-report.json"
if gitleaks git --config .gitleaks.toml --no-banner --report-format json --report-path "$history_report" --log-opts="--all" .; then
  record_failure "the configured history scan no longer reports the retired debug key"
elif ! grep -q 'notes/retired-debug.env' "$history_report" || ! grep -q 'aws-access-token' "$history_report"; then
  record_failure "the history scan did not identify the retired debug key"
fi
if ((failures > 0)); then
  printf '\nLab check failed with %d problem(s).\n' "$failures" >&2
  exit 1
fi

printf '\nAll Lab 2 checks passed.\n'
